# Server
PORT=4000
NODE_ENV=development

# Comma separated list of origins allowed to call the API (POS web app, Expo dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# PostgreSQL
DATABASE_URL=postgresql://tappay:tappay@localhost:5432/tappay

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Payments
SESSION_TTL_SECONDS=120
PAYMENT_REQUEST_TTL_SECONDS=86400
MAX_PIN_ATTEMPTS=5
